{
  "name": "youtrace",
  "version": "1.0.7",
  "description": "有迹（YouTrace）— 本地优先的个人执行与努力记录桌面应用",
  "main": "./out/main/index.js",
  "author": "YouTrace",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "predev": "node -e \"require('electron')\"",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "npm run typecheck && electron-vite build",
    "build:icon": "python scripts/build_icon.py",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:electron": "playwright test",
    "test:performance": "vitest run --config vitest.performance.config.ts",
    "test:docs": "node scripts/validate-doc-links.mjs",
    "dist:win": "npm run build && electron-builder --win nsis portable",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@tanstack/react-query": "5.101.4",
    "archiver": "7.0.1",
    "better-sqlite3": "13.0.2",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "lucide-react": "1.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "unzipper": "0.12.3",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/archiver": "6.0.3",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.19.11",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/unzipper": "0.10.11",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "com.youtrace.desktop",
    "productName": "有迹",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "youtrace-tray.png"
      }
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "YouTrace-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "YouTrace-${version}-Portable.${ext}"
    }
  }
}
